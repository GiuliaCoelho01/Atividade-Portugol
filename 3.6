programa
{
    funcao inicio()
    {
        // 3.6. Leia 6 notas válidas (de 0 a 10),
        // calcule e exiba a média simples.

        real nota, soma = 0, media
        inteiro contador = 1

        enquanto (contador <= 6)
        {
            escreva("Digite a nota ", contador, " (0 a 10): ")
            leia(nota)

            enquanto (nota < 0 ou nota > 10)
            {
                escreva("Nota invalida! Digite uma nota de 0 a 10: ")
                leia(nota)
            }

            soma = soma + nota
            contador = contador + 1
        }

        media = soma / 6

        escreva("\nMedia final: ", media)
    }
}
