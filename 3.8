programa
{
    funcao inicio()
    {
        // 3.8. Imprima os 10 primeiros números inteiros maiores que 100.

        inteiro numero = 101
        inteiro contador = 1

        enquanto (contador <= 10)
        {
            escreva(numero, "\n")

            numero = numero + 1
            contador = contador + 1
        }
    }
}
