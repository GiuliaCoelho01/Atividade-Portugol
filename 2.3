programa
{
    funcao inicio()
    {
        inteiro num1, num2, num3

        // 2.3. Leia 3 valores diferentes e mostre o maior.

        escreva("Insira três números: ")
        leia(num1, num2, num3)

        se (num1 > num2 e num1 > num3)
        {
            escreva("Esse número é o maior: ", num1)
        }
        senao se (num2 > num1 e num2 > num3)
        {
            escreva("Esse número é o maior: ", num2)
        }
        senao
        {
            escreva("Esse número é o maior: ", num3)
        }
    }
}
