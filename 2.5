programa
{
    funcao inicio()
    {
        real n1, n2, n3, n4, n5, n6
        real soma, media

        // 2.5. Leia 6 valores, exiba todos e calcule a média aritmética.

        escreva("Informe o primeiro número: ")
        leia(n1)

        escreva("Informe o segundo número: ")
        leia(n2)

        escreva("Informe o terceiro número: ")
        leia(n3)

        escreva("Informe o quarto número: ")
        leia(n4)

        escreva("Informe o quinto número: ")
        leia(n5)

        escreva("Informe o sexto número: ")
        leia(n6)

        soma = n1 + n2 + n3 + n4 + n5 + n6
        media = soma / 6

        escreva("\nValores informados: ")
        escreva(n1, ", ", n2, ", ", n3, ", ", n4, ", ", n5, ", ", n6)

        escreva("\nMédia: ", media)
    }
}
