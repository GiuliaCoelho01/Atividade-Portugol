programa
{
    funcao inicio()
    {
        // 3.7. Leia um valor N (N > 0) e imprima
        // todos os inteiros de 1 até N.

        inteiro N
        inteiro contador = 1

        escreva("Digite um valor maior que 0: ")
        leia(N)

        enquanto (N <= 0)
        {
            escreva("Valor invalido! Digite um valor maior que 0: ")
            leia(N)
        }

        enquanto (contador <= N)
        {
            escreva(contador, "\n")
            contador = contador + 1
        }
    }
}
