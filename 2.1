programa
{
    funcao inicio()
    {
        inteiro num1, num2

        // 2.1. Leia dois números e mostre o maior deles.

        escreva("Insira dois números: ")
        leia(num1, num2)

        se (num1 > num2)
        {
            escreva("Esse número é o maior: ", num1)
        }
        senao
        {
            escreva("Esse número é o maior: ", num2)
        }
    }
}
